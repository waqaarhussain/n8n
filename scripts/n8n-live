#!/usr/bin/env bash
set -euo pipefail
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi
cd -- "$(cat /etc/waqaar-n8n.path)"
exec 9>/var/lock/waqaar-n8n.lock
flock -n 9 || { echo 'Another n8n maintenance command is running.' >&2; exit 1; }
cmd=${1:-update}
[[ $(basename "$0") == n8n-setup ]] && cmd=setup
[[ $(basename "$0") == helper ]] && cmd=helper
[[ $(basename "$0") == school-import ]] && cmd=school-import
[[ $(basename "$0") == telegram ]] && cmd=telegram
[[ $(basename "$0") == school-groups ]] && cmd=school-groups
[[ $(basename "$0") == vps-manage ]] && cmd=vps-manage
[[ $(basename "$0") == school-reset ]] && cmd=school-reset
backup() {
  local target="$PWD/backups/$(date -u +%Y%m%dT%H%M%SZ)"
  install -d -m 700 "$target"
  for unit in n8n-telegram.service n8n-work-bot.service; do
    if systemctl is-active --quiet "$unit"; then systemctl stop "$unit"; fi
  done
  docker compose stop n8n school-bridge
  trap 'docker compose up -d >/dev/null; for unit in n8n-telegram.service n8n-work-bot.service; do if systemctl is-enabled --quiet "$unit" 2>/dev/null; then systemctl start "$unit"; fi; done' EXIT
  docker compose exec -T postgres pg_dump -U n8n -d n8n -Fc > "$target/n8n.dump"
  cp .env "$target/env"
  cp -a config data "$target/"
  docker compose run --rm --no-deps --user 0 --entrypoint sh -v "$target:/backup" n8n -c 'tar czf /backup/n8n-data.tgz -C /home/node/.n8n .'
  git rev-parse HEAD > "$target/commit"
  chmod -R go-rwx "$target"
  docker compose up -d --wait --wait-timeout 180
  for unit in n8n-telegram.service n8n-work-bot.service; do
    if systemctl is-enabled --quiet "$unit" 2>/dev/null; then systemctl start "$unit"; fi
  done
  trap - EXIT
  echo "Backup: $target (contains credentials; keep private)."
}
case "$cmd" in
  update)
    [[ -z $(git status --porcelain --untracked-files=no) ]] || { echo 'Tracked local edits found; commit or stash them first.'; exit 1; }
    backup
    git pull --ff-only origin main
    docker compose config --quiet
    docker compose build school-bridge
    docker compose -f compose.yml -f compose.setup.yml run --rm --no-deps --user 0:0 school-bridge python setup.py --remove-inout
    docker compose up -d --wait --wait-timeout 180
    install -m 755 scripts/n8n-live /usr/local/bin/n8n-live
    python3 scripts/install-helper.py
    python3 scripts/install-telegram.py
    echo 'Updated. Your configured credentials, database and edited workflows are preserved.'
    ;;
  backup) backup ;;
  setup)
    docker compose -f compose.yml -f compose.setup.yml run --rm --no-deps --user 0:0 school-bridge python setup.py
    chown root:1000 config/settings.json
    chmod 640 config/settings.json
    docker compose restart school-bridge
    ;;
  setup-textmebot|enable-textmebot)
    flag=--textmebot
    [[ $cmd == enable-textmebot ]] && flag=--enable-textmebot
    docker compose -f compose.yml -f compose.setup.yml run --rm --no-deps --user 0:0 school-bridge python setup.py "$flag"
    ;;
  check-textmebot) docker compose exec -T school-bridge python textmebot.py ;;
  remove-whatsapp)
    docker compose -f compose.yml -f compose.setup.yml run --rm --no-deps --user 0:0 school-bridge python setup.py --remove-whatsapp
    ;;
  check-icloud) docker compose exec -T school-bridge python setup.py --check ;;
  check-mail) docker compose exec -T school-bridge python mailbox_check.py ;;
  school-import|import)
    docker compose -f compose.yml -f compose.setup.yml run --rm --no-deps --user 0:0 school-bridge python setup.py --select-calendar
    python3 scripts/import-school.py
    ;;
  reboot-setup) backup; python3 scripts/vps.py --keys-only ;;
  vps-manage) backup; python3 scripts/vps.py ;;
  vps-import) python3 scripts/import-vps.py ;;
  school-groups)
    docker compose -f compose.yml -f compose.setup.yml run --rm --no-deps --user 0:0 school-bridge python school_history.py groups
    ;;
  school-reset)
    docker compose stop n8n school-bridge
    trap 'docker compose up -d --wait --wait-timeout 180 >/dev/null' EXIT
    docker compose run --rm --no-deps school-bridge python school_history.py reset
    docker compose up -d --wait --wait-timeout 180
    trap - EXIT
    ;;
  web)
    python3 scripts/environment.py --web
    docker compose config --quiet
    docker compose pull caddy
    docker compose up -d --force-recreate n8n
    if grep -qx 'COMPOSE_PROFILES=https' .env; then
      docker compose up -d --force-recreate caddy
    else
      docker compose --profile https stop caddy
    fi
    python3 scripts/finish.py
    ;;
  helper)
    python3 scripts/install-helper.py
    # Release the maintenance lock before the selected helper acquires it.
    exec 9>&-
    exec python3 scripts/helper-menu.py
    ;;
  review-last) docker compose exec -T school-bridge python review.py ;;
  telegram) python3 scripts/telegram.py helper ;;
  telegram-status) python3 scripts/telegram.py status ;;
  work-bot)
    if systemctl is-active --quiet n8n-work-bot.service; then systemctl stop n8n-work-bot.service; fi
    trap 'if systemctl is-enabled --quiet n8n-work-bot.service 2>/dev/null; then systemctl start n8n-work-bot.service; fi' EXIT
    python3 scripts/work_bot.py setup
    systemctl enable --now n8n-work-bot.service
    trap - EXIT
    ;;
  work-bot-status) python3 scripts/work_bot.py status ;;
  stats) python3 scripts/stats.py ;;
  stats-reset) python3 scripts/stats.py reset ;;
  status) docker compose ps ;;
  logs) docker compose logs --tail=80 n8n school-bridge ;;
  upgrade-engine)
    backup
    docker pull docker.n8n.io/n8nio/n8n:stable
    image_ref=$(docker image inspect docker.n8n.io/n8nio/n8n:stable --format '{{index .RepoDigests 0}}')
    python3 scripts/environment.py --image "$image_ref"
    docker compose up -d --wait --wait-timeout 180
    ;;
  *) echo 'Usage: n8n-live {helper|telegram|telegram-status|work-bot|work-bot-status|update|backup|setup|check-icloud|check-mail|remove-whatsapp|setup-textmebot|check-textmebot|enable-textmebot|school-import|vps-import|vps-manage|school-groups|school-reset|web|review-last|stats|stats-reset|status|logs|upgrade-engine}'; exit 2 ;;
esac
